<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Thanh kéo mở BottomSheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#44FFFFFF" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="Chia sẻ lên"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#22FFFFFF" />

    <!-- Hàng 1: Nền tảng chia sẻ nhanh -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Sao chép link -->
            <LinearLayout
                android:id="@+id/btnShareCopyLink"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#2F3142"
                    android:padding="12dp"
                    android:src="@drawable/ic_search"
                    app:tint="#00E676" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sao chép"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tải video về máy -->
            <LinearLayout
                android:id="@+id/btnShareDownload"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#2F3142"
                    android:padding="12dp"
                    android:src="@drawable/ic_download"
                    app:tint="#25F4EE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Lưu video"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tốc độ phát -->
            <LinearLayout
                android:id="@+id/btnShareSpeed"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#2F3142"
                    android:padding="12dp"
                    android:src="@drawable/ic_speed"
                    app:tint="#FACE15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tốc độ"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Chia sẻ khác -->
            <LinearLayout
                android:id="@+id/btnShareMore"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="#2F3142"
                    android:padding="12dp"
                    android:src="@drawable/ic_share"
                    app:tint="#FE2C55" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Khác"
                    android:textColor="#DDFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#22FFFFFF" />

    <!-- Nút Hủy -->
    <TextView
        android:id="@+id/btnShareCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="Hủy"
        android:textColor="#88FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>