<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 1. ViewPager2 lướt dọc Native TikTok 120Hz Snap to Page -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- 2. Thanh điều hướng trên cùng (Auto-Scroll | Tabs | Tìm kiếm) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <!-- Nút Tự động cuộn (Bật / Tắt tức thì) -->
        <TextView
            android:id="@+id/btnToggleAutoScroll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pill_autoscroll_on"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="⚡ Tự cuộn: BẬT"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Tabs ở giữa: Đang theo dõi | Dành cho bạn -->
        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTabFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Theo dõi"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#33FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTabForYou"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Dành cho bạn"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút Tìm kiếm kính lúp -->
        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Tìm kiếm video" />

    </RelativeLayout>

    <!-- 3. Vòng tròn tải dữ liệu ban đầu -->
    <ProgressBar
        android:id="@+id/initProgress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FE2C55" />

</FrameLayout>
