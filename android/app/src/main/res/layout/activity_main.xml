<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- 1. ViewPager2 lướt dọc Native TikTok 120Hz Snap to Page -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />

    <!-- 2. Thanh điều hướng trên cùng chuẩn TikTok Mobile (Không LIVE - Tabs: Bạn bè | Đã follow | Đề xuất) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="38dp"
        android:paddingBottom="6dp">

        <!-- Nút Tự động cuộn thu gọn tinh tế -->
        <TextView
            android:id="@+id/btnToggleAutoScroll"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_pill_autoscroll_on"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="⚡ Tự cuộn"
            android:textColor="#00E676"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Tabs ở giữa chuẩn TikTok: Bạn bè | Đã follow | Đề xuất -->
        <LinearLayout
            android:id="@+id/tabsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Tab 1: Bạn bè -->
            <LinearLayout
                android:id="@+id/tabFriendsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvTabFriends"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn bè"
                    android:textColor="#88FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indicatorFriends"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 2: Đã follow -->
            <LinearLayout
                android:id="@+id/tabFollowingLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvTabFollowing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đã follow"
                    android:textColor="#88FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indicatorFollowing"
                    android:layout_width="22dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- Tab 3: Đề xuất (Mặc định chọn) -->
            <LinearLayout
                android:id="@+id/tabForYouLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <TextView
                    android:id="@+id/tvTabForYou"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đề xuất"
                    android:textColor="#FFFFFF"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/indicatorForYou"
                    android:layout_width="24dp"
                    android:layout_height="2.5dp"
                    android:layout_marginTop="3dp"
                    android:background="#FFFFFF"
                    android:visibility="visible" />
            </LinearLayout>

        </LinearLayout>

        <!-- Nút Kính lúp Tìm kiếm -->
        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="5dp"
            android:src="@drawable/ic_search"
            android:contentDescription="Tìm kiếm video" />

    </LinearLayout>

    <!-- 3. Thanh điều hướng dưới cùng chuẩn TikTok Mobile (5 Tabs) -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tab 1: Trang chủ -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tiktok_home"
                android:contentDescription="Trang chủ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Trang chủ"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Cửa hàng -->
        <LinearLayout
            android:id="@+id/navShop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tiktok_shop"
                android:contentDescription="Cửa hàng" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cửa hàng"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 3: Nút Tạo (+) -->
        <LinearLayout
            android:id="@+id/navCreate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_tiktok_create"
                android:contentDescription="Tạo video" />
        </LinearLayout>

        <!-- Tab 4: Hộp thư -->
        <LinearLayout
            android:id="@+id/navInbox"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tiktok_inbox"
                android:contentDescription="Hộp thư" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hộp thư"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tab 5: Hồ sơ -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tiktok_profile"
                android:contentDescription="Hồ sơ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hồ sơ"
                android:textColor="#88FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Đường viền mỏng ngăn cách Bottom Nav -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="50dp"
        android:background="#20FFFFFF" />

    <!-- 4. Vòng tròn tải dữ liệu ban đầu -->
    <ProgressBar
        android:id="@+id/initProgress"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FE2C55" />

    <!-- 5. MÀN HÌNH TÌM KIẾM TOÀN MÀN HÌNH CHUẨN TIKTOK (Search Overlay) -->
    <LinearLayout
        android:id="@+id/layoutSearchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12131A"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Search Bar -->
        <LinearLayout
            android:id="@+id/searchTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="38dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivSearchBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Quay lại" />

            <!-- Khung nhập tìm kiếm bo tròn -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:background="#222332"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/etSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Tìm kiếm trên TikTok..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivSearchClear"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    android:contentDescription="Xóa" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSubmitSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp"
                android:text="Tìm kiếm"
                android:textColor="#FE2C55"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Các tab danh mục tìm kiếm: Top | Video | Âm thanh | Người dùng -->
        <LinearLayout
            android:id="@+id/layoutSearchCategoryTabs"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="Top"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="Video"
                android:textColor="#88FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="Âm thanh"
                android:textColor="#88FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Người dùng"
                android:textColor="#88FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Thẻ gợi ý từ khóa thịnh hành -->
        <ScrollView
            android:id="@+id/scrollSearchSuggestions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Tìm kiếm thịnh hành Việt Nam"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/listHotKeywords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>

        <!-- Danh sách kết quả tìm kiếm (Grid 2 cột TikTok) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 6. MÀN HÌNH HỒ SƠ KÊNH TOÀN MÀN HÌNH CHUẨN TIKTOK 100% (Creator Profile Overlay) -->
    <LinearLayout
        android:id="@+id/layoutProfileOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#12131A"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Bar Profile -->
        <LinearLayout
            android:id="@+id/profileTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingTop="38dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivProfileBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Quay lại" />

            <TextView
                android:id="@+id/tvProfileTopTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="\@tiktok_vietnam"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivProfileShare"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="4dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Chia sẻ" />
        </LinearLayout>

        <!-- Header thông tin tác giả -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <!-- Avatar lớn -->
            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_avatar_circle"
                android:scaleType="centerCrop"
                android:contentDescription="Avatar Profile" />

            <TextView
                android:id="@+id/tvProfileNickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tên Tác Giả"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProfileHandle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="\@unique_id"
                android:textColor="#88FFFFFF"
                android:textSize="13sp" />

            <!-- 3 Cột thống kê: Đang follow | Follower | Thích -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileFollowingCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="142"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đang follow"
                        android:textColor="#88FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="#20FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileFollowersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="254.8K"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Follower"
                        android:textColor="#88FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="#20FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileLikesCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3.8M"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thích"
                        android:textColor="#88FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Hàng nút: Follow (Đỏ) | Nhắn tin -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnProfileFollow"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:backgroundTint="#FE2C55"
                    android:text="Follow"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnProfileMessage"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#262738"
                    android:text="Nhắn tin"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tiểu sử (Bio) -->
            <TextView
                android:id="@+id/tvProfileBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Âm nhạc &amp; Video thư giãn mỗi ngày ✨ Liên hệ hợp tác qua bio"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Tab biểu tượng Video (3 vạch gạch ngang) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#161722"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶ Video"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp"
                    android:background="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 Đã thích"
                    android:textColor="#66FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Lưới Video của Kênh: 3 Cột chuẩn TikTok -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProfileVideos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0D0E15"
            android:padding="2dp" />

    </LinearLayout>

</FrameLayout>
