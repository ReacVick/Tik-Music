<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#121217" />
            <stroke
                android:width="1dp"
                android:color="#2A2A38" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#1E1E28" />
        </shape>
    </item>
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#25F4EE"
                android:startColor="#FE2C55" />
        </shape>
    </item>
</layer-list>